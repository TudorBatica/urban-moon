PUBLIC_CALENDLY_URL=                            # e.g. https://calendly.com/urban-moon/30min; empty skips the booking step

GCS_BUCKET=um-submissions                       # where submissions go; unset turns sending off
STORAGE_EMULATOR_HOST=http://localhost:4443     # the local emulator (npm run deps:up); unset in production
# GCS_ACCESS_TOKEN=                             # only to try a real bucket from a laptop: gcloud auth print-access-token
# APP_VERSION=dev                               # recorded in each manifest
