{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "input-capture",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-10",
  // nodejs_compat lets the Worker use the Node built-ins SvelteKit's server code touches.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Secrets are never set here (`wrangler secret put`). Non-secret config lives in `vars`:
  "vars": {
    // The Calendly event link for the booking step; empty skips it.
    "PUBLIC_CALENDLY_URL": ""
  }
}
