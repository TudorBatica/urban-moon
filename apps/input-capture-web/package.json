{
	"name": "@urban-moon/input-capture-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"start": "node build",
		"deploy": "ADAPTER=cloudflare npm run build && wrangler deploy",
		"preview:cf": "ADAPTER=cloudflare npm run build && wrangler dev"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.0"
	},
	"dependencies": {
		"@urban-moon/domain-data": "*",
		"idb-keyval": "^6.3.0",
		"zod": "^4.6.5"
	}
}
