GCS_BUCKET=um-submissions                       # the bucket whose pending/ the worker works through
STORAGE_EMULATOR_HOST=http://localhost:4443     # the local emulator (npm run deps:up); unset in production
# GCS_ACCESS_TOKEN=                             # only to use a real bucket from a laptop: gcloud auth print-access-token
# PORT=3001
# PDF_CONCURRENCY=2                             # PDFs built at the same time
# RUN_BUDGET_SECONDS=1200                       # a run starts no new submission after this long
# APP_VERSION=dev                               # recorded in build.json, done.json and failed/<id>
