# The worker image's build context (BuildKit reads <Dockerfile>.dockerignore instead of the root
# .dockerignore). An allowlist: only what the image copies, so no .env, output or client data.
**
!package.json
!package-lock.json
!apps/input-capture-web/package.json
!apps/input-pdf-worker/package.json
!apps/input-pdf-worker/src
!apps/input-pdf-worker/fonts
!packages/domain-data/package.json
!packages/domain-data/src
!packages/bucket/package.json
!packages/bucket/src
**/*.test.ts
