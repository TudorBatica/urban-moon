{
	"name": "@urban-moon/input-pdf-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Works through pending/ in the bucket: builds each committed submission's PDF and stores it next to the submission.",
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"dev": "WORKER_TICK=${WORKER_TICK:-60} tsx watch --env-file-if-exists=.env src/main.ts",
		"start": "tsx src/main.ts",
		"pdf:tick": "tsx scripts/pdf-tick.ts",
		"pdf:reprocess": "tsx --env-file-if-exists=.env scripts/pdf-reprocess.ts",
		"pdf:demo": "tsx scripts/pdf-demo.ts",
		"pdf:build": "tsx src/cli.ts"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"@urban-moon/bucket": "*",
		"@urban-moon/domain-data": "*",
		"pdf-lib": "^1.17.1",
		"tsx": "^4.23.13"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	}
}
