	"properties": {
		"schemaVersion": {
			"type": "number",
			"const": 1
		},
		"submissionId": {
			"type": "string",
			"pattern": "^[A-Za-z0-9-]{8,80}$"
		},
		"committedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
		},
		"appVersion": {
			"type": "string",
			"minLength": 1
		},
		"pageUri": {
			"type": "string"
		},
		"locale": {
			"type": "string",
			"const": "ro"
		},
		"client": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"email": {
					"type": "string",
					"format": "email",
					"pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
				}
			},
			"required": [
				"name",
				"email"
			],
			"additionalProperties": false
		},
		"rooms": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"bucatarie",
					"living",
					"dormitor",
					"birou",
					"baie",
					"hol",
					"alta"
				]
			}
		},
