# Settings for scripts/deploy-web.sh (docs/deployment.md). Not secret: change here, commit, deploy.
# Every deploy applies all of them, so a change made by hand in the console is undone by the next one.

PROJECT_ID=urban-moon-508616
REGION=europe-west1
SERVICE=input-capture-web
REPO=urban-moon
BUCKET=urban-moon-intake
SERVICE_ACCOUNT=web-sa@urban-moon-508616.iam.gserviceaccount.com

# The public address of the site. Empty: the service's own https://…run.app URL.
WEB_ORIGIN=
# The Calendly event link for the booking step after sending. Empty: straight to the thanks page.
PUBLIC_CALENDLY_URL=
# Largest request body the server accepts (the commit carries the drawing's SVG).
BODY_SIZE_LIMIT=8M

# Cloud Run sizing. MAX_INSTANCES is the cost ceiling; MIN_INSTANCES above 0 bills around the clock.
CPU=1
MEMORY=512Mi
CONCURRENCY=80
MIN_INSTANCES=0
MAX_INSTANCES=3
TIMEOUT=60
