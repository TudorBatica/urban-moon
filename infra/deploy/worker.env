# Settings for scripts/deploy-worker.sh. Not secret: change here, commit, deploy.
# Every deploy applies all of them, so a change made by hand in the console is undone by the next one.
# Fixed in the script, not here: private service, one instance, one request at a time.

PROJECT_ID=urban-moon-508616
REGION=europe-west1
SERVICE=input-pdf-worker
REPO=urban-moon
BUCKET=urban-moon-intake
SERVICE_ACCOUNT=pdf-worker-sa@urban-moon-508616.iam.gserviceaccount.com
# The Cloud Scheduler job that calls POST /run every minute.
SCHEDULER_JOB=pdf-run

# Submissions built at the same time in one run. Each holds its files and its PDF in memory.
PDF_CONCURRENCY=2
# A run starts no new submission after this long; the next run continues. Keep it below TIMEOUT.
RUN_BUDGET_SECONDS=1200

# Cloud Run sizing. Billed only while a run is in progress (request-based billing, min instances 0).
CPU=2
MEMORY=4Gi
# Node's heap limit, below MEMORY so the process fails with a clear error before the container is killed.
NODE_HEAP_MB=3072
# Longest a /run request may take, in seconds: the budget plus one build. Scheduler's deadline is 30 min.
TIMEOUT=1800

# HubSpot delivery. The token is NOT here: it is a Secret Manager
# secret, and HUBSPOT_SECRET names it. Leave HUBSPOT_SECRET empty to deploy without delivery — the
# worker then builds and stores PDFs and records that nothing was sent.
HUBSPOT_SECRET=hubspot-token
HUBSPOT_PORTAL_ID=146798766
HUBSPOT_FORM_ID=25774231-d10e-4879-88b1-dfd2547b5d8b
# Where the uploaded PDFs land in the File Manager. HubSpot keeps its own private copy per submission.
HUBSPOT_FOLDER_PATH=/app-input-capture
